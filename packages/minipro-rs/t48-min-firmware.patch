@@ -4,3 +4,12 @@
 //! This re-uses the TL866II+ implementation.
 
 pub use super::tl866iiplus::Tl866iiPlusProtocol as T48Protocol;
+
+/// Minimum firmware version for the T48.
+///
+/// The T48 numbers its firmware independently of the TL866II+ series
+/// (`0x11b` = 0.1.27, `0x127` = 01.1.39), so the TL866II+ minimum (0x255)
+/// can never be reached and rejected every T48.  Upstream C minipro expects
+/// 0x127 (`T48_FIRMWARE_VERSION` in `t48.h`); 0x120 (01.1.32) is the previous
+/// official release and the oldest firmware that C tool supports.
+pub const MIN_FIRMWARE_T48: u32 = 0x120; // 01.1.32
